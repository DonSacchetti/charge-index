# Charge Index — local environment
#
# Copy this file to `.env.local` in the same folder as package.json, then fill
# in the values. `.env.local` is gitignored and must never be committed: this
# repository is public.
#
#   cp docs/env.local.template .env.local
#
# Where each value comes from is noted beside it. Anything marked SECRET must
# never be pasted into a chat, an email, or this repository.

# ── Supabase ───────────────────────────────────────────────────────────────
# Supabase → your project → Project Settings → API
# The URL and the publishable (anon) key are safe to expose — they ship to the
# browser, and the database's row-level security is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://nwjtxdacyydxerysdbyl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses every access rule in the database. Needed only by the
# verification scripts and the reminder job — never by the website itself.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (the bot check on signup and login) ───────────────
# Cloudflare dashboard → Turnstile → your widget.
# The SITE key belongs here and in Vercel. The SECRET key does NOT go in this
# file at all — it goes into Supabase → Authentication → Attack Protection.
# Leave this blank and the bot check simply doesn't appear.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Reminders (switched off until an email provider exists) ────────────────
# Any long random string, matching the GitHub secret of the same name.
CRON_SECRET=
# The address the app is served from, e.g. https://app.soenenstrategies.com
APP_URL=
