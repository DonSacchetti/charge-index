# Charge Index — local environment
#
# Copy this file to `.env.local` in the same folder as package.json, then fill
# in the values. `.env.local` is gitignored and must never be committed: this
# repository is public.
#
#   cp docs/env.local.template .env.local
#
# Where each value comes from is noted beside it. Anything marked SECRET must
# never be pasted into a chat, an email, or this repository.

# ── Supabase ───────────────────────────────────────────────────────────────
# Supabase → your project → Project Settings → API Keys
#
# Don't be thrown by the names. These two variables are called ANON_KEY and
# SERVICE_ROLE_KEY for historical reasons, but this project uses Supabase's
# newer key format, so the values you paste in start with `sb_publishable_`
# and `sb_secret_`. That's correct — keep the variable names as they are.
#
# The URL and the publishable key are safe to expose: they ship to the browser,
# and the database's row-level security is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://nwjtxdacyydxerysdbyl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses every access rule in the database. Needed only by the
# verification scripts and the reminder job — never by the website itself.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (the bot check on signup and login) ───────────────
# Cloudflare dashboard → Turnstile → your widget.
# The SITE key belongs here and in Vercel. The SECRET key does NOT go in this
# file at all — it goes into Supabase → Authentication → Attack Protection.
# Leave this blank and the bot check simply doesn't appear.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Supabase control plane (for migrations and project admin) ─────────────
# Supabase → Account → Access Tokens. SECRET — it can administer the whole
# project, so it's the one to revoke first if a laptop goes missing.
#
# The same token also goes in .claude/settings.local.json, which is what gives
# Claude Code its Supabase tools. Two files because two different programs read
# them: node scripts read this one, Claude Code reads the other.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=nwjtxdacyydxerysdbyl

# ── Booking links (the "Book a call" / "Book the session" buttons) ─────────
# Your Calendly (or any booking page) links. Leave them blank and the buttons
# explain that booking isn't open yet and offer your email instead — they never
# lead anywhere broken. Paste a link here and in Vercel, redeploy, and that
# button starts working. Not secret.
NEXT_PUBLIC_BOOKING_URL_CALL=
NEXT_PUBLIC_BOOKING_URL_SESSION=

# ── Reminders (switched off until an email provider exists) ────────────────
# Any long random string, matching the GitHub secret of the same name.
CRON_SECRET=
# The address the app is served from, e.g. https://app.soenenstrategies.com
APP_URL=
